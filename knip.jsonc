{
	// Step 0 has no code under src/ yet, so its roots and the dependency graph they
	// would justify are absent on purpose. Step 1 adds test/, Step 2 adds src/.
	"$schema": "./node_modules/knip/schema-jsonc.json",
	"entry": ["scripts/*.ts", "tools/oxlint/*/index.ts"],
	"project": ["scripts/**/*.ts", "tools/oxlint/epsilon/**/*.ts", "src/app/**/*.css"],
	"ignore": ["tools/oxlint/anti-slop/**"],
	"rules": {
		"dependencies": "off",
		"devDependencies": "off",
	},
	"treatConfigHintsAsErrors": true,
}
