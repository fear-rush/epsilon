{
	"$schema": "./node_modules/turbo/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**"],
			"env": ["NODE_ENV", "VITE_*"],
			"inputs": ["$TURBO_DEFAULT$", ".env", ".env.*", "!.env.example"]
		},
		"api:export": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"env": [
				"NODE_ENV",
				"PORT",
				"VITE_*",
				"EPSILON_PROJECT",
				"EPSILON_AGENT_HOME",
				"PI_CODING_AGENT_DIR"
			],
			"dependsOn": ["^build"]
		},
		"type-check": {
			"dependsOn": ["^build"],
			"outputs": [],
			"env": ["NODE_ENV"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"env": ["NODE_ENV", "CI"],
			"inputs": ["$TURBO_DEFAULT$", ".env", ".env.*", "!.env.example"]
		}
	},
	"globalDependencies": [
		".gitignore",
		"turbo.json",
		"package.json",
		"bun.lock",
		"tsconfig.json",
		"tsconfig.base.json",
		"bunfig.toml"
	],
	"globalEnv": ["NODE_ENV", "CI"]
}
