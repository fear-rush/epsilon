{
	"name": "epsilon",
	"version": "0.5.1",
	"description": "A web dashboard for the pi coding agent on your machine",
	"license": "MIT",
	"author": "Muhammad Firas",
	"workspaces": [
		"./server",
		"./client",
		"./shared"
	],
	"type": "module",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"dev:host": "bun run scripts/dev.ts --host",
		"dev:client": "bun run scripts/dev.ts --filter=client",
		"dev:server": "bun run scripts/dev.ts --filter=server",
		"build": "turbo build",
		"build:client": "turbo build --filter=client",
		"build:server": "turbo build --filter=server",
		"lint": "oxlint .",
		"dead-code": "knip",
		"type-check": "tsc --noEmit && turbo type-check",
		"test": "turbo test",
		"postinstall": "bun run routes:generate && turbo build --filter=shared --filter=server && bun run api:generate",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"api:generate": "turbo run api:export --filter=server",
		"routes:generate": "bun run --cwd client routes:generate",
		"sandbox:clean": "bun run scripts/sandbox.ts clean",
		"hooks:install": "prek install",
		"hooks:run": "prek run --all-files",
		"hooks:update": "prek update"
	},
	"dependencies": {},
	"devDependencies": {
		"@j178/prek": "0.5.7",
		"@oxlint/plugins": "1.90.0",
		"@types/bun": "1.4.4",
		"knip": "6.44.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"turbo": "2.11.10",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=26.13.0"
	},
	"packageManager": "bun@1.4.4"
}
