{
	"name": "epsilon",
	"version": "0.6.0",
	"private": true,
	"description": "A web dashboard for the pi coding agent on your machine",
	"license": "MIT",
	"author": "Muhammad Firas",
	"type": "module",
	"imports": {
		"#domain/*": "./src/domain/*.ts",
		"#protocol/*": "./src/protocol/*.ts"
	},
	"scripts": {
		"bench": "bun run scripts/bench/run.ts",
		"build": "bun run routes:generate && vite build && bun build src/backend/main.ts src/engine/main.ts --target bun --outdir dist",
		"check": "bun run format:check && bun run doc-check && bun run lint && bun run type-check && bun run dead-code && bun run test",
		"dead-code": "knip --cycles",
		"dev": "bun run scripts/dev.ts",
		"dev:host": "bun run scripts/dev.ts --host",
		"doc-check": "bun run scripts/doc-check.ts",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"hooks:install": "prek install",
		"hooks:run": "prek run --all-files",
		"lint": "effect-tsgo oxlint --type-aware --report-unused-disable-directives --deny-warnings",
		"lint:fix": "effect-tsgo oxlint --type-aware --fix",
		"parity": "bun run scripts/parity.ts",
		"postinstall": "bun run routes:generate",
		"routes:generate": "tsr generate",
		"sandbox:clean": "bun run scripts/sandbox.ts clean",
		"shoot": "bun run scripts/shoot.ts",
		"start": "bun dist/backend/main.js",
		"test": "bun test --timeout 5000",
		"test:bounded": "bun run scripts/bounded.ts 180 -- bun test",
		"test:e2e": "bun run build && playwright test",
		"test:tools": "bun test tools",
		"type-check": "tsc -b"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@codemirror/autocomplete": "6.20.3",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/lint": "6.9.7",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.14",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@effect/platform-bun": "4.1.1",
		"@lezer/highlight": "1.2.5",
		"@shadcn/react": "0.3.1",
		"@tanstack/react-query": "5.105.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-virtual": "3.14.24",
		"class-variance-authority": "0.7.1",
		"cmdk": "1.1.1",
		"cn": "0.5.0",
		"effect": "4.1.1",
		"fflate": "0.8.3",
		"lucide-react": "1.64.0",
		"proper-lockfile": "4.1.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"shiki": "4.5.0",
		"typebox": "1.3.27",
		"yaml": "2.8.1"
	},
	"devDependencies": {
		"@effect/tsgo": "0.63.0",
		"@j178/prek": "0.5.7",
		"@oxlint/plugins": "1.90.0",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-cli": "1.167.46",
		"@tanstack/router-plugin": "1.168.48",
		"@types/bun": "1.4.4",
		"@types/node": "26.6.6",
		"@types/proper-lockfile": "4.1.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"knip": "6.44.0",
		"oxc-transform-react": "0.156.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"shadcn": "4.23.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.5"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=26.13.0"
	},
	"packageManager": "bun@1.4.4"
}
