{
	"openapi": "3.1.0",
	"info": {
		"title": "epsilon API",
		"version": "0.0.1",
		"description": "Local REST surface for sessions and for configuring this deployment."
	},
	"components": {
		"schemas": {
			"Readiness": {
				"oneOf": [
					{
						"type": "object",
						"properties": {
							"ready": {
								"type": "boolean",
								"enum": [
									true
								]
							}
						},
						"required": [
							"ready"
						]
					},
					{
						"type": "object",
						"properties": {
							"ready": {
								"type": "boolean",
								"enum": [
									false
								]
							},
							"detail": {
								"type": "string"
							},
							"fix": {
								"type": "string"
							},
							"home": {
								"type": "string"
							}
						},
						"required": [
							"ready",
							"detail",
							"fix",
							"home"
						]
					}
				]
			},
			"SessionList": {
				"type": "object",
				"properties": {
					"project": {
						"type": "string"
					},
					"sessions": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/SessionSummary"
						}
					}
				},
				"required": [
					"project",
					"sessions"
				]
			},
			"SessionSummary": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"cwd": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"created": {
						"type": "string"
					},
					"modified": {
						"type": "string"
					},
					"messageCount": {
						"type": "integer",
						"minimum": 0
					},
					"firstMessage": {
						"type": "string"
					},
					"running": {
						"type": "boolean"
					},
					"needsInput": {
						"type": "boolean"
					}
				},
				"required": [
					"id",
					"cwd",
					"created",
					"modified",
					"messageCount",
					"firstMessage",
					"running",
					"needsInput"
				]
			},
			"SessionError": {
				"allOf": [
					{
						"$ref": "#/components/schemas/Problem"
					},
					{
						"type": "object",
						"properties": {
							"code": {
								"type": "string",
								"enum": [
									"SESSION_NOT_FOUND",
									"SESSION_RUNNING"
								]
							}
						},
						"required": [
							"code"
						]
					}
				]
			},
			"Problem": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					}
				},
				"required": [
					"message"
				]
			},
			"SettingsSnapshot": {
				"type": "object",
				"properties": {
					"home": {
						"type": "string"
					},
					"defaultModel": {
						"$ref": "#/components/schemas/DefaultModel"
					},
					"providers": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/ProviderView"
						}
					},
					"builtins": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/BuiltinProvider"
						}
					},
					"models": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/SnapshotModel"
						}
					},
					"mcp": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/McpServerView"
						}
					},
					"mcpDisabled": {
						"type": "boolean"
					},
					"projectDir": {
						"type": "string"
					},
					"skills": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/SkillView"
						}
					},
					"packages": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/PackageView"
						}
					},
					"ready": {
						"type": "boolean"
					},
					"error": {
						"type": "string"
					}
				},
				"required": [
					"home",
					"defaultModel",
					"providers",
					"builtins",
					"models",
					"mcp",
					"mcpDisabled",
					"projectDir",
					"skills",
					"packages",
					"ready"
				]
			},
			"DefaultModel": {
				"type": [
					"object",
					"null"
				],
				"properties": {
					"provider": {
						"type": "string"
					},
					"modelId": {
						"type": "string"
					}
				},
				"required": [
					"provider",
					"modelId"
				]
			},
			"ProviderView": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"baseUrl": {
						"type": "string"
					},
					"api": {
						"type": "string",
						"enum": [
							"openai-completions",
							"openai-responses",
							"anthropic-messages",
							"google-generative-ai"
						]
					},
					"modelCount": {
						"type": "integer",
						"minimum": 0
					},
					"configured": {
						"type": "boolean"
					},
					"source": {
						"type": "string"
					},
					"hasKey": {
						"type": "boolean"
					},
					"custom": {
						"type": "boolean"
					},
					"builtin": {
						"type": "boolean"
					}
				},
				"required": [
					"id",
					"name",
					"modelCount",
					"configured",
					"hasKey",
					"custom",
					"builtin"
				]
			},
			"BuiltinProvider": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"configured": {
						"type": "boolean"
					}
				},
				"required": [
					"id",
					"name",
					"configured"
				]
			},
			"SnapshotModel": {
				"type": "object",
				"properties": {
					"provider": {
						"type": "string"
					},
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					}
				},
				"required": [
					"provider",
					"id",
					"name"
				]
			},
			"McpServerView": {
				"oneOf": [
					{
						"$ref": "#/components/schemas/McpServerEntry"
					},
					{
						"$ref": "#/components/schemas/McpOverrideEntry"
					},
					{
						"$ref": "#/components/schemas/McpInvalidEntry"
					}
				],
				"discriminator": {
					"propertyName": "kind",
					"mapping": {
						"server": "#/components/schemas/McpServerEntry",
						"override": "#/components/schemas/McpOverrideEntry",
						"invalid": "#/components/schemas/McpInvalidEntry"
					}
				}
			},
			"McpServerEntry": {
				"type": "object",
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"server"
						]
					},
					"scope": {
						"type": "string",
						"enum": [
							"global",
							"project"
						]
					},
					"name": {
						"type": "string"
					},
					"target": {
						"type": "string"
					},
					"transport": {
						"type": "string",
						"enum": [
							"stdio",
							"http"
						]
					},
					"description": {
						"type": "string"
					},
					"enabled": {
						"type": "boolean"
					},
					"exposure": {
						"type": "string",
						"enum": [
							"codemode",
							"deferred",
							"direct",
							"hidden"
						]
					},
					"timeout": {
						"type": "number"
					},
					"relation": {
						"type": "string",
						"enum": [
							"replaces-global",
							"replaced-by-project",
							"overridden-by-project"
						]
					}
				},
				"required": [
					"kind",
					"scope",
					"name",
					"target",
					"transport",
					"enabled"
				]
			},
			"McpOverrideEntry": {
				"type": "object",
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"override"
						]
					},
					"scope": {
						"type": "string",
						"enum": [
							"project"
						]
					},
					"name": {
						"type": "string"
					},
					"target": {
						"type": "string"
					},
					"transport": {
						"type": "string",
						"enum": [
							"stdio",
							"http"
						]
					},
					"description": {
						"type": "string"
					},
					"enabled": {
						"type": "boolean"
					},
					"exposure": {
						"type": "string",
						"enum": [
							"codemode",
							"deferred",
							"direct",
							"hidden"
						]
					},
					"timeout": {
						"type": "number"
					},
					"overrideKeys": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"enabled",
								"exposure",
								"toolExposure"
							]
						}
					},
					"overrideEnabled": {
						"type": "boolean"
					}
				},
				"required": [
					"kind",
					"scope",
					"name",
					"target",
					"transport",
					"enabled",
					"overrideKeys"
				]
			},
			"McpInvalidEntry": {
				"type": "object",
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"invalid"
						]
					},
					"name": {
						"type": "string"
					},
					"scope": {
						"type": "string",
						"enum": [
							"global",
							"project"
						]
					},
					"problem": {
						"type": "string"
					},
					"enabled": {
						"type": "boolean"
					},
					"overrideKeys": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"enabled",
								"exposure",
								"toolExposure"
							]
						}
					}
				},
				"required": [
					"kind",
					"name",
					"scope",
					"problem",
					"enabled"
				]
			},
			"SkillView": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"path": {
						"type": "string"
					}
				},
				"required": [
					"name",
					"description",
					"path"
				]
			},
			"PackageView": {
				"type": "object",
				"properties": {
					"source": {
						"type": "string"
					},
					"scope": {
						"type": "string",
						"enum": [
							"user",
							"project"
						]
					},
					"installedPath": {
						"type": "string"
					}
				},
				"required": [
					"source",
					"scope"
				]
			},
			"ProviderDetail": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"baseUrl": {
						"type": "string"
					},
					"api": {
						"type": "string",
						"enum": [
							"openai-completions",
							"openai-responses",
							"anthropic-messages",
							"google-generative-ai"
						]
					},
					"stored": {
						"$ref": "#/components/schemas/ProviderStored"
					},
					"builtin": {
						"type": "boolean"
					},
					"custom": {
						"type": "boolean"
					},
					"configured": {
						"type": "boolean"
					},
					"source": {
						"type": "string"
					},
					"hasKey": {
						"type": "boolean"
					},
					"headerKeys": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"models": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/ProviderModelInput"
						}
					},
					"modelOverrides": {
						"type": "object",
						"additionalProperties": {
							"$ref": "#/components/schemas/ModelOverride"
						}
					},
					"catalog": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/SnapshotModel"
						}
					}
				},
				"required": [
					"id",
					"name",
					"stored",
					"builtin",
					"custom",
					"configured",
					"hasKey",
					"headerKeys",
					"models",
					"modelOverrides",
					"catalog"
				]
			},
			"ProviderStored": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"baseUrl": {
						"type": "string"
					},
					"api": {
						"type": "string",
						"enum": [
							"openai-completions",
							"openai-responses",
							"anthropic-messages",
							"google-generative-ai"
						]
					},
					"compat": {
						"$ref": "#/components/schemas/ReasoningCompat"
					}
				}
			},
			"ReasoningCompat": {
				"type": "object",
				"properties": {
					"thinkingFormat": {
						"type": "string",
						"enum": [
							"openai",
							"openrouter",
							"deepseek",
							"together",
							"baseten",
							"zai",
							"qwen",
							"chat-template",
							"qwen-chat-template",
							"string-thinking",
							"ant-ling"
						]
					},
					"supportsReasoningEffort": {
						"type": "boolean"
					},
					"thinkingTokenBudgetField": {
						"type": "string",
						"enum": [
							"thinking_token_budget",
							"thinking_budget",
							"thinking_budget_tokens"
						]
					},
					"requiresReasoningContentOnAssistantMessages": {
						"type": "boolean"
					},
					"forceAdaptiveThinking": {
						"type": "boolean"
					}
				},
				"additionalProperties": {}
			},
			"ProviderModelInput": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"name": {
						"type": "string"
					},
					"api": {
						"type": "string",
						"enum": [
							"openai-completions",
							"openai-responses",
							"anthropic-messages",
							"google-generative-ai"
						]
					},
					"baseUrl": {
						"type": "string",
						"format": "uri"
					},
					"reasoning": {
						"type": "boolean"
					},
					"thinkingLevelMap": {
						"$ref": "#/components/schemas/ThinkingLevelMap"
					},
					"compat": {
						"$ref": "#/components/schemas/ReasoningCompat"
					},
					"input": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"text",
								"image"
							]
						}
					},
					"contextWindow": {
						"type": "integer",
						"exclusiveMinimum": 0
					},
					"maxTokens": {
						"type": "integer",
						"exclusiveMinimum": 0
					},
					"cost": {
						"$ref": "#/components/schemas/ProviderModelCost"
					}
				},
				"required": [
					"id"
				]
			},
			"ThinkingLevelMap": {
				"type": "object",
				"properties": {
					"off": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"minimal": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"low": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"medium": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"high": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"xhigh": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"max": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					}
				}
			},
			"ProviderModelCost": {
				"type": "object",
				"properties": {
					"input": {
						"type": "number"
					},
					"output": {
						"type": "number"
					},
					"cacheRead": {
						"type": "number"
					},
					"cacheWrite": {
						"type": "number"
					}
				},
				"required": [
					"input",
					"output",
					"cacheRead",
					"cacheWrite"
				]
			},
			"ModelOverride": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"api": {
						"type": "string",
						"enum": [
							"openai-completions",
							"openai-responses",
							"anthropic-messages",
							"google-generative-ai"
						]
					},
					"baseUrl": {
						"type": "string",
						"format": "uri"
					},
					"reasoning": {
						"type": "boolean"
					},
					"thinkingLevelMap": {
						"$ref": "#/components/schemas/ThinkingLevelMap"
					},
					"compat": {
						"$ref": "#/components/schemas/ReasoningCompat"
					},
					"input": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"text",
								"image"
							]
						}
					},
					"contextWindow": {
						"type": "integer",
						"exclusiveMinimum": 0
					},
					"maxTokens": {
						"type": "integer",
						"exclusiveMinimum": 0
					},
					"cost": {
						"$ref": "#/components/schemas/ProviderModelCost"
					}
				}
			},
			"ProviderImportResult": {
				"type": "object",
				"properties": {
					"models": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/ProviderModelInput"
						}
					}
				},
				"required": [
					"models"
				]
			},
			"ProviderImportInput": {
				"type": "object",
				"properties": {
					"providerId": {
						"type": "string"
					},
					"baseUrl": {
						"type": "string",
						"format": "uri"
					},
					"api": {
						"type": "string",
						"enum": [
							"openai-completions",
							"openai-responses",
							"anthropic-messages",
							"google-generative-ai"
						]
					},
					"apiKey": {
						"type": "string"
					}
				},
				"required": [
					"baseUrl",
					"api"
				]
			},
			"ProviderTestResult": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					}
				},
				"required": [
					"message"
				]
			},
			"ProviderTestInput": {
				"type": "object",
				"properties": {
					"providerId": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"baseUrl": {
						"anyOf": [
							{
								"type": "string",
								"enum": [
									""
								]
							},
							{
								"type": "string",
								"format": "uri"
							}
						]
					},
					"api": {
						"type": "string",
						"enum": [
							"openai-completions",
							"openai-responses",
							"anthropic-messages",
							"google-generative-ai"
						]
					},
					"apiKey": {
						"type": "string"
					},
					"headers": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						}
					},
					"compat": {
						"$ref": "#/components/schemas/ReasoningCompat"
					},
					"level": {
						"type": "string",
						"enum": [
							"off",
							"minimal",
							"low",
							"medium",
							"high",
							"xhigh",
							"max"
						]
					},
					"model": {
						"$ref": "#/components/schemas/ProviderModelInput"
					}
