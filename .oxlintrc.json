{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./node_modules/@effect/tsgo/oxlint-presets/strict.json"],
	"plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "promise", "node"],
	"jsPlugins": [
		"./tools/oxlint/anti-slop/index.ts",
		"./tools/oxlint/anti-slop/effect/index.ts",
		"./tools/oxlint/epsilon/index.ts"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"env": {
		"es2026": true
	},
	"options": {
		"typeAware": true
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/node_modules/**",
		"src/app/routeTree.gen.ts",
		"tools/oxlint/anti-slop/**",
		".agents/**",
		".claude/**",
		".sandbox/**"
	],
	"rules": {
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error",
		"anti-slop-effect/no-service-constructor-imports": "error",
		"epsilon/design-tokens": "error",
		"epsilon/effect-only-io": "off",
		"epsilon/no-feature-internals": "off",
		"epsilon/no-real-sleep": "off",
		"eslint/eqeqeq": "error",
		"eslint/no-await-in-loop": "error",
		"eslint/no-console": "error",
		"eslint/no-else-return": "error",
		"eslint/no-empty": "error",
		"eslint/no-lonely-if": "error",
		"eslint/no-negated-condition": "error",
		"eslint/no-param-reassign": "error",
		"eslint/no-promise-executor-return": "error",
		"eslint/no-useless-rename": "error",
		"eslint/no-underscore-dangle": ["error", { "allow": ["_tag"] }],
		"eslint/no-var": "error",
		"eslint/no-warning-comments": "error",
		"eslint/object-shorthand": "error",
		"eslint/prefer-const": "error",
		"import/no-cycle": "error",
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
		"import/no-duplicates": "error",
		"import/no-self-import": "error",
		"oxc/no-accumulating-spread": "error",
		"oxc/no-map-spread": "error",
		"react/jsx-boolean-value": "error",
		"react/no-array-index-key": "error",
		"react/no-danger": "error",
		"react/no-unescaped-entities": "error",
		"react/react-in-jsx-scope": "off",
		"react/self-closing-comp": "error",
		"typescript/await-thenable": "error",
		"typescript/ban-ts-comment": "error",
		"typescript/consistent-type-imports": "error",
		"typescript/no-base-to-string": "error",
		"typescript/no-deprecated": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-import-type-side-effects": "error",
		"typescript/no-inferrable-types": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-misused-spread": "error",
		"typescript/no-non-null-assertion": "error",
		"typescript/no-unnecessary-condition": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/only-throw-error": "error",
		"typescript/prefer-for-of": "error",
		"typescript/prefer-nullish-coalescing": "error",
		"typescript/prefer-optional-chain": "error",
		"typescript/prefer-promise-reject-errors": "error",
		"typescript/require-await": "error",
		"typescript/restrict-template-expressions": "error",
		"typescript/strict-boolean-expressions": "error",
		"typescript/switch-exhaustiveness-check": [
			"error",
			{
				"considerDefaultExhaustiveForUnions": true
			}
		],
		"unicorn/no-typeof-undefined": "error",
		"unicorn/prefer-array-find": "error",
		"unicorn/prefer-at": "error",
		"unicorn/prefer-node-protocol": "error",
		"unicorn/prefer-set-has": "error",
		"unicorn/prefer-string-replace-all": "error",
		"unicorn/prefer-structured-clone": "error",
		"unicorn/prefer-type-error": "error",
		"unicorn/throw-new-error": "error",
		"effecttsgo/unstable-api-usage": "off"
	},
	"overrides": [
		{
			"files": ["**/*.test.ts", "**/*.test.tsx", "test/**", "**/*.e2e.ts"],
			"rules": {
				"epsilon/no-real-sleep": "error",
				"typescript/await-thenable": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off",
				"unicorn/consistent-function-scoping": "off"
			}
		},
		{
			"files": ["scripts/**"],
			"rules": {
				"eslint/no-console": "off"
			}
		},
		{
			// TanStack Router signals a redirect by throwing the redirect value, which is
			// not an Error. The throw is the API, not a mistake.
			"files": ["src/app/routes/**"],
			"rules": {
				"typescript/only-throw-error": "off"
			}
		},
		{
			"files": ["src/app/**"],
			"rules": {
				"epsilon/no-feature-internals": [
					"error",
					{
						"root": "src/app/features",
						"aliasRoot": "src/app"
					}
				]
			}
		},
		{
			// The status surfaces own tone and colour. A feature or route reports through them
			// and never paints a state colour itself.
			"files": ["src/app/features/**", "src/app/routes/**"],
			"rules": {
				"epsilon/feedback-surfaces": "error"
			}
		},
		{
			// Vendored from ui.shadcn.com and rewritten by `shadcn add`, or a third-party
			// primitive's own defaults: raw sizes and colours there are not ours to change.
			"files": ["src/app/components/ui/**/*.tsx", "src/app/components/editor/**/*.{ts,tsx}"],
			"rules": {
				"epsilon/design-tokens": "off"
			}
		},
		{
			// Registry files are replaced wholesale by `shadcn add`. Rules they violate by
			// construction are off here, not silenced at each line, so a re-add stays clean.
			"files": ["src/app/components/ui/**/*.tsx"],
			"rules": {
				"anti-slop/no-runtime-typeof": "off",
				"anti-slop/require-safety-comment-for-type-assertion": "off",
				"eslint/eqeqeq": "off",
				"jsx-a11y/click-events-have-key-events": "off",
				"jsx-a11y/control-has-associated-label": "off",
				"jsx-a11y/label-has-associated-control": "off",
				"jsx-a11y/no-noninteractive-element-interactions": "off",
				"jsx-a11y/no-noninteractive-tabindex": "off",
				"jsx-a11y/prefer-tag-over-role": "off",
				"react/no-array-index-key": "off",
				"react/only-export-components": "off",
				"typescript/consistent-return": "off",
				"typescript/no-unnecessary-condition": "off",
				"typescript/no-unsafe-type-assertion": "off",
				"typescript/strict-boolean-expressions": "off"
			}
		},
		{
			// Two deliberate departures in the restored primitives. The file tree nests a list
			// inside a treeitem, which is the ARIA group role with no element of its own. The
			// pane bar keys an entrance on its text; the helper already excludes elements.
			"files": [
				"src/app/components/editor/file-tree.tsx",
				"src/app/components/patterns/pane/pane-bar.tsx"
			],
			"rules": {
				"jsx-a11y/prefer-tag-over-role": "off",
				"typescript/no-base-to-string": "off"
			}
		},
		{
			// main's cache warmer is a reading, not a control, and it is focusable only so its
			// tooltip opens on Tab; there is no action to give a button.
			"files": ["src/app/features/conversation/composer/cache-warming.tsx"],
			"rules": {
				"jsx-a11y/no-noninteractive-tabindex": "off"
			}
		},
		{
			// main's composer takes a dropped file anywhere on the box. The paperclip is the
			// keyboard path; the drop is a pointer enhancement over it.
			"files": ["src/app/features/conversation/composer.tsx"],
			"rules": {
				"jsx-a11y/no-noninteractive-element-interactions": "off"
			}
		},
		{
			// Both rows are render-only and keep no state: the same file can legitimately be
			// attached twice, and a streaming block is its index in the turn.
			"files": [
				"src/app/features/conversation/composer/attachments.tsx",
				"src/app/features/conversation/transcript.tsx",
				"src/app/features/conversation/tool-trace.tsx"
			],
			"rules": {
				"react/no-array-index-key": "off"
			}
		},
		{
			"files": ["src/protocol/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"node:*",
									"bun:*",
									"react",
									"react-dom",
									"react/*",
									"@earendil-works/*",
									"#domain/*",
									"#backend/*",
									"#engine/*",
									"#app/*"
								],
								"message": "src/protocol is the wire format: only effect/schema and its own files."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/domain/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"node:*",
									"bun:*",
									"react",
									"react-dom",
									"react/*",
									"@earendil-works/*",
									"#backend/*",
									"#engine/*",
									"#app/*"
								],
								"message": "src/domain is pure: no runtime, framework or server imports."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/app/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["node:*", "bun:*", "@earendil-works/*", "#backend/*", "#engine/*"],
								"message": "The browser bundle may not reach server or engine code."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/backend/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["react", "react-dom", "react/*", "#app/*", "#engine/*"],
								"message": "The server does not import the app or the engine."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/engine/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["react", "react-dom", "react/*", "#app/*", "#backend/*"],
								"message": "The engine does not import the app or the server."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/backend/**", "src/engine/**"],
			"rules": {
				"epsilon/effect-only-io": "error"
			}
		},
		{
			"files": [
				"src/backend/platform/**",
				"src/backend/main.ts",
				"src/engine/main.ts",
				"src/engine/trust.ts"
			],
			"rules": {
				"epsilon/effect-only-io": "off"
			}
		},
		{
			// The server's features are the folders under `src/backend`; the files beside them
			// (main.ts, handlers.ts, serve.ts) are the composition root and may reach in, as the
			// page's routes do. There is no `@/` alias on the server, so no aliasRoot: `#domain`
			// and `#protocol` name other roots, not a feature.
			"files": ["src/backend/*/**"],
			"rules": {
				"epsilon/no-feature-internals": [
					"error",
					{
						"root": "src/backend",
						// Today's cross-feature edges: a feature that reads a live chat's tools,
						// skills or context reaches the registry, and the registry asks the session
						// index and Epsilon's own settings. Give a feature an index.ts when it
						// grows a second caller and delete its entry here.
						"open": [
							"platform",
							"conversation/registry.ts",
							"sessions/catalog.ts",
							"sessions/locks.ts",
							"settings/epsilon.ts",
							"settings/projects/service.ts"
						]
					}
				]
			}
		},
		{
			"files": ["tools/oxlint/**"],
			"rules": {
				"anti-slop/no-runtime-typeof": "off",
				"anti-slop/no-unknown-parameters": "off"
			}
		},
		{
			"files": [
				"test/setup.ts",
				"test/until.ts",
				"test/fixtures/**",
				"test/e2e/app.ts",
				"test/e2e/stub-model.ts"
			],
			"rules": {
				"epsilon/no-real-sleep": "off"
			}
		},
		{
			"files": ["test/**", "scripts/**"],
			"rules": {
				"anti-slop/no-known-value-widening": "off",
				"anti-slop/no-runtime-typeof": "off",
				"anti-slop/no-unknown-parameters": "off",
				"anti-slop/no-unsafe-dictionary-type": "off",
				"anti-slop/require-safety-comment-for-type-assertion": "off"
			}
		},
		{
			"files": ["src/**/*.test.ts"],
			"rules": {
				"no-restricted-imports": "off",
				"effecttsgo/strict-effect-provide": "off"
			}
		},
		{
			"files": [
				"src/protocol/errors.ts",
				"src/backend/platform/errors.ts",
				"src/engine/errors.ts",
				"src/app/core/errors.ts"
			],
			"rules": {
				"unicorn/throw-new-error": "off"
			}
		},
		{
			"files": ["src/backend/platform/patch.ts", "src/backend/platform/json-document.ts"],
			"rules": {
				"anti-slop/no-known-value-widening": "off",
				"anti-slop/no-runtime-typeof": "off"
			}
		},
		{
			"files": ["src/backend/platform/**"],
			"rules": {
				"anti-slop/no-object-parameters": "off",
				"anti-slop/no-runtime-typeof": "off",
				"anti-slop/no-unknown-parameters": "off"
			}
		},
		{
			"files": ["src/backend/main.ts", "scripts/bench/**"],
			"rules": {
				"effecttsgo/strict-effect-provide": "off"
			}
		},
		{
			"files": ["src/backend/**/*.test.ts"],
			"rules": {
				"epsilon/effect-only-io": "off"
			}
		},
		{
			"files": ["src/backend/sessions/ingest.ts"],
			"rules": {
				"anti-slop/no-runtime-typeof": "off",
				"epsilon/effect-only-io": "off",
				"typescript/no-unsafe-type-assertion": "off"
			}
		},
		{
			"files": ["src/backend/settings/mcp/entries.ts"],
			"rules": {
				"anti-slop/no-runtime-typeof": "off",
				"effecttsgo/prefer-typed-schema-decoder": "off"
			}
		},
		{
			"files": ["src/backend/settings/providers/login.ts"],
			"rules": {
				"effecttsgo/abort-controller-in-effect": "off",
				"effecttsgo/global-error-in-effect-failure": "off"
			}
		},
		{
			"files": ["src/backend/platform/pi.ts"],
			"rules": {
				"effecttsgo/run-effect-inside-effect": "off"
			}
		},
		{
			"files": ["src/backend/settings/skills/frontmatter.ts"],
			"rules": {
				"typescript/no-unsafe-type-assertion": "off"
			}
		},
		{
			"files": [
				"src/engine/main.ts",
				"src/engine/translate.ts",
				"src/engine/ui.ts",
				"src/engine/trust.ts"
			],
			"rules": {
				"anti-slop/no-runtime-typeof": "off",
				"anti-slop/no-unknown-parameters": "off",
				"anti-slop/no-unsafe-dictionary-type": "off",
				"typescript/no-unsafe-type-assertion": "off"
			}
		},
		{
			"files": ["src/engine/session.ts", "src/backend/conversation/engine.ts"],
			"rules": {
				"typescript/no-this-alias": "off"
			}
		},
		{
			"files": ["test/fixtures/**"],
			"rules": {
				"anti-slop/no-chained-type-assertions": "off",
				"typescript/no-unsafe-type-assertion": "off"
			}
		}
	]
}
