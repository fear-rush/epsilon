{
	"printWidth": 100,
	"useTabs": true,
	"sortImports": { "internalPattern": ["@/", "#protocol/", "#domain/"] },
	"sortPackageJson": { "sortScripts": true },
	"sortTailwindcss": { "functions": ["cn", "cva"], "stylesheet": "./src/app/index.css" },
	"ignorePatterns": [
		"**/dist/**",
		"src/app/routeTree.gen.ts",
		"src/app/styles/tokens.gen.css",
		"bun.lock",
		".agent/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".continue/**",
		".cursor/**",
		".gemini/**",
		".opencode/**",
		".pi/**",
		".roo/**",
		".sandbox/**",
		".windsurf/**",
		"tools/oxlint/anti-slop/**"
	]
}
