{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "../../dist/types/src/app",
		"tsBuildInfoFile": "../../dist/types/src/app/tsbuildinfo",
		"jsx": "react-jsx",
		"lib": ["es2025", "dom", "dom.iterable"],
		"types": ["vite/client"],
		"paths": { "@/*": ["./*"] }
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["**/*.test.ts", "**/*.test.tsx"],
	"references": [{ "path": "../protocol" }, { "path": "../domain" }]
}
